{
  "name": "randsum-monorepo",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@size-limit/preset-small-lib": "12.1.0",
    "@types/bun": "catalog:",
    "bunup": "0.16.32",
    "knip": "6.25.0",
    "lefthook": "2.1.14",
    "mitata": "catalog:",
    "size-limit": "12.1.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.14.0",
    "bun": ">=1.4.0"
  },
  "catalog": {
    "fast-check": "4.8.0",
    "@types/bun": "1.4.0",
    "mitata": "1.0.34",
    "typescript": "7.0.2",
    "wrangler": "4.147.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "overrides": {
    "sharp": ">=0.35.4 <1"
  },
  "scripts": {
    "prepare": "[ -z \"$CI\" ] && [ -d .git ] && (git config --unset-all --local core.hooksPath 2>/dev/null; lefthook install) || true",
    "check:workspace-scripts": "bun scripts/check-workspace-scripts.ts",
    "skills:sync": "bun scripts/sync-cloudflare-skills.ts",
    "check:ci-aggregator": "bun scripts/check-ci-aggregator.ts",
    "check:changesets": "bun scripts/check-changesets.ts",
    "build": "bun run --filter '@randsum/mcp...' build",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "bun run --filter '@randsum/*' typecheck && bun run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p scripts",
    "size": "bun run --filter '*' size",
    "check": "bun run check:workspace-scripts && bun run check:ci-aggregator && bun run check:changesets && biome ci . && bun run typecheck:scripts && bun run --filter '@randsum/*' check",
    "bench": "bun run packages/roller/__benchmarks__/roll.bench.ts",
    "profile": "bun --cpu-prof packages/roller/__benchmarks__/roll.bench.ts",
    "profile:md": "bun --cpu-prof-md packages/roller/__benchmarks__/roll.bench.ts",
    "knip": "knip --exclude catalog --no-config-hints",
    "fix:all": "biome check --write .",
    "site:build": "bun --filter @randsum/site build",
    "site:dev": "bun run --filter @randsum/site dev",
    "changeset": "bunx changeset",
    "version-packages": "bunx changeset version",
    "publish": "bun run build && bun scripts/publish.ts"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ]
}
