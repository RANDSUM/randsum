{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["scripts/*.ts"],
      "ignoreDependencies": ["mitata", "claude-code"]
    },
    "packages/roller": {
      "entry": [
        "src/index.ts",
        "src/errors.ts",
        "src/tokenize.ts",
        "src/validate.ts",
        "src/trace/index.ts",
        "src/docs/index.ts"
      ],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/games": {
      "entry": ["src/index.ts", "src/schema.ts", "src/*.generated.ts", "__tests__/**/*.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/mcp": {
      "entry": ["src/index.ts", "src/remote.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      "includeEntryExports": true
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/discord-bot": {
      "entry": ["src/worker/index.ts", "src/deploy-commands.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/site": {
      "ignoreDependencies": ["@astrojs/ts-content-mapper", "satteri"]
    }
  },
  "ignoreBinaries": ["skills-ref"],
  "ignore": ["**/bunup.config.ts", "**/*.generated.ts", "apps/site/public/app/sw.js"],
  "exclude": ["optionalPeerDependencies", "unresolved"],
  "ignoreExportsUsedInFile": true
}
