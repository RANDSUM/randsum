{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["scripts/*.ts"],
      "ignoreDependencies": ["mitata", "claude-code"]
    },
    "packages/roller": {
      "entry": [
        "src/index.ts",
        "src/errors.ts",
        "src/tokenize.ts",
        "src/validate.ts",
        "src/trace/index.ts",
        "src/docs/index.ts"
      ],
      "project": ["src/**/*.ts", "!src/**/*.test.ts"],
      "includeEntryExports": true
    },
    "packages/games": {
      "entry": ["src/index.ts", "src/schema.ts", "src/*.generated.ts", "__tests__/**/*.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/mcp": {
      "entry": ["src/index.ts", "src/remote.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "__tests__/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/notation-spec": {
      "entry": ["src/index.ts", "src/cli.ts", "examples/**/*.ts", "__tests__/**/*.test.ts"],
      "project": ["src/**/*.ts", "examples/**/*.ts", "__tests__/**/*.ts"],
      "includeEntryExports": true
    },
    "packages/ui": {
      "entry": [
        "src/roller-max.tsx",
        "src/roller-compact.tsx",
        "src/roller-mini.tsx",
        "src/keys.ts",
        "src/presets.ts",
        "scripts/*.ts",
        "__tests__/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "scripts/*.ts", "__tests__/**/*.{ts,tsx}"],
      "includeEntryExports": true
    },
    "apps/api": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/discord-bot": {
      "entry": ["src/worker/index.ts", "src/deploy-commands.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/site": {
      "entry": ["scripts/*.ts", "src/routeData.ts"],
      "ignoreDependencies": ["@astrojs/ts-content-mapper", "satteri"]
    }
  },
  "ignoreBinaries": ["skills-ref"],
  "ignore": [
    "**/bunup.config.ts",
    "**/*.generated.ts",
    "apps/site/public/app/sw.js",
    "apps/site/app-public/sw.js"
  ],
  "exclude": ["optionalPeerDependencies", "unresolved"],
  "ignoreExportsUsedInFile": true
}
