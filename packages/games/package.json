{
  "name": "@randsum/games",
  "description": "TTRPG game packages using RDN-conformant dice notation for the RANDSUM ecosystem",
  "version": "4.1.0",
  "type": "module",
  "sideEffects": true,
  "private": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "*.randsum.json",
    "randsum.json",
    "LICENSE",
    "README.md"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./fifth": {
      "import": {
        "types": "./dist/fifth.generated.d.ts",
        "default": "./dist/fifth.generated.js"
      }
    },
    "./pbta": {
      "import": {
        "types": "./dist/pbta.generated.d.ts",
        "default": "./dist/pbta.generated.js"
      }
    },
    "./blades": {
      "import": {
        "types": "./dist/blades.generated.d.ts",
        "default": "./dist/blades.generated.js"
      }
    },
    "./daggerheart": {
      "import": {
        "types": "./dist/daggerheart.generated.d.ts",
        "default": "./dist/daggerheart.generated.js"
      }
    },
    "./fate": {
      "import": {
        "types": "./dist/fate.generated.d.ts",
        "default": "./dist/fate.generated.js"
      }
    },
    "./salvageunion": {
      "import": {
        "types": "./dist/salvageunion.generated.d.ts",
        "default": "./dist/salvageunion.generated.js"
      }
    },
    "./root-rpg": {
      "import": {
        "types": "./dist/root-rpg.generated.d.ts",
        "default": "./dist/root-rpg.generated.js"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./schema": {
      "import": {
        "types": "./dist/schema.d.ts",
        "default": "./dist/schema.js"
      }
    },
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
  "homepage": "https://randsum.dev/games/overview/",
  "bugs": "https://github.com/RANDSUM/randsum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANDSUM/randsum.git",
    "directory": "packages/games"
  },
  "keywords": [
    "dice",
    "rpg",
    "ttrpg",
    "game",
    "blades-in-the-dark",
    "daggerheart",
    "fate-core",
    "fudge",
    "dnd",
    "5e",
    "pbta",
    "salvage-union",
    "root-rpg",
    "randsum",
    "typescript",
    "codegen"
  ],
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@randsum/roller": "workspace:~"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "fast-check": "catalog:"
  },
  "scripts": {
    "prepublishOnly": "bun ../../scripts/ensure-bun-publish.ts && bun run build",
    "build": "bunup",
    "gen": "bun run codegen.ts",
    "gen:check": "bun run codegen.ts --check",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check": "bun run build && bun run typecheck && bun run test"
  }
}
