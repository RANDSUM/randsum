{
  "name": "@randsum/mcp",
  "description": "Model Context Protocol server exposing the RANDSUM dice rolling ecosystem to AI agents, over stdio or Streamable HTTP",
  "version": "2.0.0",
  "private": false,
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
  "homepage": "https://randsum.dev/tools/mcp/",
  "bugs": "https://github.com/RANDSUM/randsum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANDSUM/randsum.git",
    "directory": "packages/mcp"
  },
  "type": "module",
  "exports": {
    "./remote": {
      "import": {
        "types": "./dist/remote.d.ts",
        "default": "./dist/remote.js"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "randsum-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "dice",
    "roller",
    "rpg",
    "mcp",
    "model-context-protocol",
    "ai",
    "llm",
    "randsum",
    "ttrpg",
    "dnd",
    "tabletop",
    "dice-roller"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@randsum/games": "workspace:~",
    "@randsum/roller": "workspace:~"
  },
  "scripts": {
    "build": "bunup && chmod +x dist/index.js",
    "dev": "bun run src/index.ts",
    "test": "bun test",
    "prepublishOnly": "bun ../../scripts/ensure-bun-publish.ts && bun run build",
    "typecheck": "tsc --noEmit",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=18.0.0"
  }
}
