{
  "name": "@randsum/ui",
  "description": "React dice roller components for the RANDSUM ecosystem, in three sizes, with narrow imports",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "private": false,
  "files": [
    "dist",
    "!dist/**/*.map",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    "./check": {
      "import": {
        "types": "./dist/check.d.ts",
        "default": "./dist/check.js"
      }
    },
    "./key-pad": {
      "import": {
        "types": "./dist/key-pad.d.ts",
        "default": "./dist/key-pad.js"
      }
    },
    "./keys": {
      "import": {
        "types": "./dist/keys.d.ts",
        "default": "./dist/keys.js"
      }
    },
    "./notation-field": {
      "import": {
        "types": "./dist/notation-field.d.ts",
        "default": "./dist/notation-field.js"
      }
    },
    "./preset-list": {
      "import": {
        "types": "./dist/preset-list.d.ts",
        "default": "./dist/preset-list.js"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      }
    },
    "./readout": {
      "import": {
        "types": "./dist/readout.d.ts",
        "default": "./dist/readout.js"
      }
    },
    "./roll-button": {
      "import": {
        "types": "./dist/roll-button.d.ts",
        "default": "./dist/roll-button.js"
      }
    },
    "./roll-steps": {
      "import": {
        "types": "./dist/roll-steps.d.ts",
        "default": "./dist/roll-steps.js"
      }
    },
    "./roller-compact": {
      "import": {
        "types": "./dist/roller-compact.d.ts",
        "default": "./dist/roller-compact.js"
      }
    },
    "./roller-max": {
      "import": {
        "types": "./dist/roller-max.d.ts",
        "default": "./dist/roller-max.js"
      }
    },
    "./roller-mini": {
      "import": {
        "types": "./dist/roller-mini.d.ts",
        "default": "./dist/roller-mini.js"
      }
    },
    "./status-line": {
      "import": {
        "types": "./dist/status-line.d.ts",
        "default": "./dist/status-line.js"
      }
    },
    "./use-roller": {
      "import": {
        "types": "./dist/use-roller.d.ts",
        "default": "./dist/use-roller.js"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
  "homepage": "https://github.com/RANDSUM/randsum/tree/main/packages/ui#readme",
  "bugs": "https://github.com/RANDSUM/randsum/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANDSUM/randsum.git",
    "directory": "packages/ui"
  },
  "engines": {
    "bun": ">=1.3.10",
    "node": ">=18.0.0"
  },
  "keywords": [
    "dice",
    "roller",
    "react",
    "components",
    "rpg",
    "ttrpg",
    "tabletop",
    "dice-roller",
    "randsum"
  ],
  "dependencies": {
    "@randsum/roller": "workspace:~"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "dev": "bunup --watch",
    "prepublishOnly": "bun ../../scripts/ensure-bun-publish.ts && bun run build",
    "build": "bunup && bun scripts/build-css.ts",
    "test": "bun test --coverage --coverage-reporter=lcov --coverage-dir=./coverage",
    "typecheck": "tsc --noEmit",
    "size": "size-limit",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "size-limit": [
    {
      "path": "dist/check.js",
      "limit": "12.5 KB"
    },
    {
      "path": "dist/key-pad.js",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/keys.js",
      "limit": "1.5 KB"
    },
    {
      "path": "dist/notation-field.js",
      "limit": "5.5 KB"
    },
    {
      "path": "dist/preset-list.js",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/presets.js",
      "limit": "5.5 KB"
    },
    {
      "path": "dist/readout.js",
      "limit": "2 KB"
    },
    {
      "path": "dist/roll-button.js",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/roll-steps.js",
      "limit": "1.75 KB"
    },
    {
      "path": "dist/roller-compact.js",
      "limit": "21.5 KB"
    },
    {
      "path": "dist/roller-max.js",
      "limit": "22 KB"
    },
    {
      "path": "dist/roller-mini.js",
      "limit": "21.5 KB"
    },
    {
      "path": "dist/status-line.js",
      "limit": "0.5 KB"
    },
    {
      "path": "dist/use-roller.js",
      "limit": "13.5 KB"
    }
  ]
}
