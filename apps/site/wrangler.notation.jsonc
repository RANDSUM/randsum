{
  // Cloudflare Worker for notation.randsum.dev: the RANDSUM Dice Notation spec.
  //
  // Static assets only, no script. `bun run build` writes dist-notation/
  // (scripts/build-notation.ts): the spec pages Astro builds under /spec/,
  // lifted to the root, with their badges, conformance vectors and assets.
  // randsum.dev/spec/* and /conformance/* 301 here (public/_redirects).
  //
  // `name` is deliberately the Worker that has always served this host. Its
  // notation.randsum.dev Custom Domain lives on the Worker, not in this file,
  // so deploying under that name keeps the hostname and its DNS record.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randsum-rdn",
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./dist-notation",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true
  }
}
