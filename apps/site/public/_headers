# Serve the hosted games meta-schema with an explicit JSON content type.
#
# The schema is reachable at its declared $id
# (https://randsum.dev/schemas/v1/randsum.json) and editors fetch it via a
# `$schema` reference, so the content type has to be application/json rather
# than whatever the host guesses.
#
# Verified live: https://randsum.dev/schemas/v1/randsum.json returns
# `application/json; charset=utf-8` from Cloudflare.
/schemas/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

# Astro fingerprints every file under /_astro/, so it can be cached forever.
# @astrojs/cloudflare used to inject this rule at build time.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
