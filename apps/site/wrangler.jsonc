{
  // Cloudflare Workers deployment for randsum.dev.
  //
  // The site is plain `output: 'static'` Astro with no adapter, deployed as an
  // assets-only Worker: there is no script, so every request is served from
  // static assets, which is free and unbilled. Redirects live in public/_redirects.
  //
  // This file is the deployable config: `wrangler deploy -c apps/site/wrangler.jsonc`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randsum-site",
  // Deliberately not "today". A compatibility date newer than the workerd
  // bundled with the locally installed wrangler makes `wrangler dev` refuse to
  // start ("requires compatibility date X, but the newest date supported by
  // this server binary is Y") — so dating this to the future costs the ability
  // to run the site locally under wrangler, the only way to check
  // public/_redirects and _headers. Cloudflare's own servers would accept a newer date; local ones will
  // not. Raise it deliberately, alongside a wrangler upgrade, never by reflex.
  "compatibility_date": "2026-07-13",
  "assets": {
    "directory": "./dist",
    // Astro's own 404 page rather than Cloudflare's bare platform error.
    "not_found_handling": "404-page"
  },
  // randsum.dev is the only front page. Without these, every deploy also
  // answers at randsum-site.<account>.workers.dev and at per-version preview
  // URLs: full copies of the site on hostnames nobody links to. The custom
  // domains (apex and www) are attached on the Worker in the dashboard.
  "workers_dev": false,
  "preview_urls": false
}
