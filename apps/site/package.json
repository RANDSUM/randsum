{
  "name": "@randsum/site",
  "version": "1.1.2",
  "description": "RANDSUM documentation and marketing website built with Astro",
  "private": true,
  "sideEffects": false,
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
  "homepage": "https://github.com/RANDSUM/randsum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANDSUM/randsum.git",
    "directory": "apps/site"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/react": "6.0.6",
    "@astrojs/starlight": "0.41.3",
    "@randsum/roller": "workspace:~",
    "@stackblitz/sdk": "~1.11.0",
    "astro": "7.3.3",
    "astro-expressive-code": "0.44.2",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "deploy:notation": "wrangler deploy -c wrangler.notation.jsonc",
    "astro": "astro",
    "test": "bun test",
    "typecheck": "astro check",
    "check": "bun run build && bun run typecheck && bun run test && bun run conformance:check",
    "conformance:gen": "bun conformance-gen.ts",
    "conformance:check": "bun conformance-gen.ts --check"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "starlight-page-actions": "0.7.1",
    "starlight-sidebar-topics": "0.8.0",
    "typescript": "6.0.3",
    "wrangler": "catalog:"
  }
}
