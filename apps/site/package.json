{
  "name": "@randsum/site",
  "version": "1.1.2",
  "description": "RANDSUM documentation and marketing website built with Astro",
  "private": true,
  "sideEffects": false,
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
  "homepage": "https://github.com/RANDSUM/randsum",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RANDSUM/randsum.git",
    "directory": "apps/site"
  },
  "type": "module",
  "dependencies": {
    "@astrojs/react": "7.1.2",
    "@astrojs/starlight": "0.42.7",
    "@randsum/notation-spec": "workspace:~",
    "@randsum/roller": "workspace:~",
    "@stackblitz/sdk": "~1.11.0",
    "astro": "7.4.4",
    "astro-expressive-code": "0.44.3",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/build-app.ts && bun scripts/build-notation.ts",
    "preview": "astro preview",
    "deploy": "wrangler deploy -c wrangler.jsonc",
    "deploy:notation": "wrangler deploy -c wrangler.notation.jsonc",
    "deploy:app": "wrangler deploy -c wrangler.app.jsonc",
    "astro": "astro",
    "test": "bun test",
    "typecheck": "astro sync && tsc --noEmit --runExternalCode",
    "check": "bun run build && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/ts-content-mapper": "0.2.0",
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "satteri": "0.10.5",
    "starlight-page-actions": "0.7.1",
    "starlight-sidebar-topics": "0.9.0",
    "typescript": "7.1.0-beta",
    "wrangler": "catalog:"
  }
}
