---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import LandingHero from '../components/landing/LandingHero.astro'
import ProductCarousel from '../components/landing/ProductCarousel.astro'
import QuickStart from '../components/landing/QuickStart.astro'
import GameSchemaSection from '../components/landing/GameSchemaSection.astro'
import GamesGrid from '../components/landing/GamesGrid.astro'
import Faq from '../components/landing/Faq.astro'
import ClosingCta from '../components/landing/ClosingCta.astro'
import LandingFooter from '../components/landing/LandingFooter.astro'
import LandingScripts from '../components/landing/LandingScripts.astro'
import { LANDING_FAQ } from '../utils/faq'
import '../styles/landing.css'

const description =
  'Open-source TypeScript dice roller and notation engine. Roll 4d6L, 2d20H and exploding dice with zero dependencies, plus rules for D&D 5e, Blades and more.'
---

<StarlightPage
  frontmatter={{
    title: 'TypeScript Dice Roller and Notation Engine',
    description,
    template: 'splash',
    head: [
      {
        tag: 'script',
        attrs: { type: 'application/ld+json' },
        content: JSON.stringify({
          '@context': 'https://schema.org',
          '@graph': [
            {
              '@type': 'WebSite',
              '@id': 'https://randsum.dev/#website',
              name: 'RANDSUM',
              url: 'https://randsum.dev/',
              description,
              publisher: { '@id': 'https://randsum.dev/#organization' }
            },
            {
              '@type': 'Organization',
              '@id': 'https://randsum.dev/#organization',
              name: 'RANDSUM',
              url: 'https://randsum.dev/',
              logo: 'https://randsum.dev/favicon.svg',
              sameAs: ['https://github.com/RANDSUM/randsum', 'https://www.npmjs.com/org/randsum']
            },
            {
              '@type': 'SoftwareSourceCode',
              '@id': 'https://randsum.dev/#roller',
              name: '@randsum/roller',
              description:
                'Zero-dependency TypeScript dice notation parser and rolling engine for tabletop RPGs.',
              codeRepository: 'https://github.com/RANDSUM/randsum',
              programmingLanguage: 'TypeScript',
              runtimePlatform: ['Bun', 'Node.js', 'Deno', 'Browser'],
              license: 'https://opensource.org/licenses/MIT',
              publisher: { '@id': 'https://randsum.dev/#organization' }
            },
            {
              '@type': 'FAQPage',
              '@id': 'https://randsum.dev/#faq',
              mainEntity: LANDING_FAQ.map(entry => ({
                '@type': 'Question',
                name: entry.question,
                acceptedAnswer: { '@type': 'Answer', text: entry.answer }
              }))
            }
          ]
        })
      }
    ]
  }}
  hasSidebar={false}
>
  <div class="landing">
    <LandingHero />
    <ProductCarousel />
    <QuickStart />
    <GameSchemaSection />
    <GamesGrid />
    <Faq />
    <ClosingCta />
    <LandingFooter />
  </div>
</StarlightPage>

<LandingScripts />
