---
// The installable roller, served at the root of app.randsum.dev. Not a
// Starlight page: it is a full-screen app with its own manifest
// (app-public/manifest.webmanifest) and an offline service worker
// (app-public/sw.js), both scoped to /. Astro builds it at /app-shell/;
// scripts/build-app.ts lifts it into dist-app/index.html and removes it from
// randsum.dev's dist, so it is never served on the docs host.
import { Font } from 'astro:assets'
import PipMark from '../../components/PipMark.astro'
import { RollerApp } from '../../components/roller-app/RollerApp'
import '../../styles/theme.css'

const title = 'RANDSUM Roller'
const description =
  'A dice roller for your phone. Type any dice notation or tap the dice, see every step of the roll, and install it to roll offline.'
const url = 'https://app.randsum.dev/'
---

<!doctype html>
<html lang="en" data-product="app">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={url}>
    <link rel="manifest" href="/manifest.webmanifest">
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="theme-color" content="">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Roller">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content="https://randsum.dev/og-image.png">
    <meta property="og:url" content={url}>
    <meta name="twitter:card" content="summary_large_image">
    <Font cssVariable="--font-gabarito" preload />
    <Font cssVariable="--font-jetbrains-mono" />
    <script is:inline>
    // Same key as Starlight's theme picker, so one choice holds across the site.
    // The status bar takes the page background once the theme is known.
    const saved = (() => {
      try {
        return localStorage.getItem('starlight-theme')
      } catch {
        return null
      }
    })()
    const scheme =
      saved === 'light' || saved === 'dark'
        ? saved
        : matchMedia('(prefers-color-scheme: light)').matches
          ? 'light'
          : 'dark'
    document.documentElement.dataset.theme = scheme
    addEventListener('DOMContentLoaded', () => {
      const meta = document.querySelector('meta[name="theme-color"]')
      if (meta) meta.setAttribute('content', getComputedStyle(document.body).backgroundColor)
    })
    </script>
  </head>
  <body>
    <header class="app-bar">
      <a href="/" class="app-title" aria-label="RANDSUM Roller">
        <PipMark variant="knockout" size={28} class="app-mark" />
        <span class="app-wordmark" translate="no">RANDSUM</span>
        <span class="app-product">app</span>
      </a>
      <div class="app-actions">
        <button type="button" class="app-link app-install" hidden>Install app</button>
        <a href="https://randsum.dev/" class="app-link">Docs</a>
      </div>
    </header>
    <main class="app-main">
      <RollerApp client:load />
    </main>
    <script>
    // Install: the browser offers its prompt once the page qualifies as an app;
    // keep it and show the header button until the user takes it.
    interface InstallPrompt extends Event {
      prompt: () => Promise<void>
    }
    const installButton = document.querySelector<HTMLButtonElement>('.app-install')
    const pending: { prompt: InstallPrompt | undefined } = { prompt: undefined }
    addEventListener('beforeinstallprompt', event => {
      if (!('prompt' in event)) return
      event.preventDefault()
      pending.prompt = event as InstallPrompt
      if (installButton) installButton.hidden = false
    })
    addEventListener('appinstalled', () => {
      pending.prompt = undefined
      if (installButton) installButton.hidden = true
    })
    installButton?.addEventListener('click', () => {
      void pending.prompt?.prompt().finally(() => {
        pending.prompt = undefined
        installButton.hidden = true
      })
    })
    </script>
    <script>
    // Offline: the worker caches this page and its assets on first visit.
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker
        .register('/sw.js', { scope: '/' })
        .then(() => navigator.serviceWorker.ready)
        .then(registration => {
          // The first visit loads before the worker controls the page, so hand it
          // every same-origin asset this page used.
          const urls = performance
            .getEntriesByType('resource')
            .map(entry => entry.name)
            .filter(name => new URL(name).origin === location.origin)
          registration.active?.postMessage({ type: 'cache', urls: [location.pathname, ...urls] })
        })
        .catch(() => {
          // No worker (private mode, old browser): the page still works online
        })
    }
    </script>
  </body>
</html>

<style is:global>
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  color-scheme: light dark;
  height: 100%;
  -webkit-tap-highlight-color: transparent;
}

html[data-theme='light'] {
  color-scheme: light;
}

html[data-theme='dark'] {
  color-scheme: dark;
}

body {
  display: flex;
  flex-direction: column;
  height: 100dvh;
  margin: 0;
  overflow: hidden;
  background: var(--rs-bg);
  color: var(--rs-fg);
  font-family: var(--rs-font-sans);
  line-height: var(--rs-leading-body);
}

.app-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
  padding: calc(0.625rem + env(safe-area-inset-top)) 1rem 0.625rem;
  border-bottom: var(--rs-border);
}

.app-title {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: var(--rs-fg);
  text-decoration: none;
}

.app-mark {
  color: var(--product-app-fill);
  flex: none;
}

.app-wordmark {
  font-size: var(--rs-text-md);
  font-weight: var(--rs-weight-heavy);
  letter-spacing: var(--rs-tracking-wordmark);
}

.app-product {
  color: var(--rs-accent);
  font-size: var(--rs-text-md);
  font-weight: var(--rs-weight-bold);
  letter-spacing: var(--rs-tracking-heading);
}

.app-actions {
  display: flex;
  align-items: center;
  gap: 0.25rem;
}

.app-link {
  padding: 0.375rem 0.625rem;
  border-radius: var(--rs-radius-sm);
  color: var(--rs-gray-2);
  font-size: var(--rs-text-sm);
  font-weight: var(--rs-weight-medium);
  text-decoration: none;
}

.app-install {
  border: none;
  background: none;
  color: var(--rs-accent);
  font-family: var(--rs-font-sans);
  font-weight: var(--rs-weight-semibold);
  cursor: pointer;
}

.app-link:hover {
  background: var(--rs-gray-6);
  color: var(--rs-fg);
}

.app-link:focus-visible,
.app-title:focus-visible {
  outline: none;
  box-shadow: var(--rs-focus-ring);
}

.app-main {
  display: flex;
  flex: 1;
  min-height: 0;
}
</style>
