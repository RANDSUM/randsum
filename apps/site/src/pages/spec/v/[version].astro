---
import { getCollection, render } from 'astro:content'
import { isLatestVersion, getVersions } from '../../../spec/versions'
import SpecLayout from '../../../spec/SpecLayout.astro'
import SpecContent from '../../../spec/components/SpecContent.astro'
import SidebarNav from '../../../spec/components/SidebarNav.astro'
import OnThisPage from '../../../spec/components/OnThisPage.astro'
import ModifierReference from '../../../spec/components/ModifierReference.astro'

export async function getStaticPaths() {
  const entries = await getCollection('specs')
  return entries.map(entry => ({
    params: { version: entry.id },
    props: { entry }
  }))
}

const { entry } = Astro.props
const { version } = Astro.params
const { Content, headings } = await render(entry)
const latest = await isLatestVersion(version)
const allVersions = await getVersions()
---

<SpecLayout
  title="RANDSUM Dice Notation Specification"
  version={version}
  versions={allVersions}
  isLatest={latest}
  specMarkdown={entry.body ?? ''}
  headings={headings}
>
  <SidebarNav slot="sidebar" headings={headings} version={version} isLatest={latest} />
  <SpecContent slot="content">
    {
      !latest && (
        <p style="margin-bottom: 1.5rem;">
          <a href="/spec/" style="color: var(--accent);">
            &larr; Back to latest
          </a>
        </p>
      )
    }
    <Content />
    {/* Generated from today's roller, so it describes only the latest version. */}
    {latest && <ModifierReference />}
  </SpecContent>
  <OnThisPage slot="aside" headings={headings} />
</SpecLayout>
