---
// A plain Astro page, not a StarlightPage: the spec keeps its own layout
// (ADR-015) inside this app. Renders the latest version inline (ADR-016).
import { getCollection, render } from 'astro:content'
import { getLatestVersion, getVersions } from '../../spec/versions'
import SpecLayout from '../../spec/SpecLayout.astro'
import SpecContent from '../../spec/components/SpecContent.astro'
import SidebarNav from '../../spec/components/SidebarNav.astro'
import OnThisPage from '../../spec/components/OnThisPage.astro'
import ModifierReference from '../../spec/components/ModifierReference.astro'

const latestId = await getLatestVersion()
const allVersions = await getVersions()
const entries = await getCollection('specs')
const entry = entries.find(e => e.id === latestId)
if (!entry) throw new Error(`No spec entry found for version: ${latestId}`)
const { Content, headings } = await render(entry)
---

<SpecLayout
  title="RANDSUM Dice Notation Specification"
  version={latestId}
  versions={allVersions}
  isLatest={true}
  specMarkdown={entry.body ?? ''}
  headings={headings}
>
  <SidebarNav slot="sidebar" headings={headings} version={latestId} isLatest={true} />
  <SpecContent slot="content">
    <Content />
    <ModifierReference />
  </SpecContent>
  <OnThisPage slot="aside" headings={headings} />
</SpecLayout>
