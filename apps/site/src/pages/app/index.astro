---
// The Roller app's product page. The app itself lives at app.randsum.dev
// (wrangler.app.jsonc, built from src/pages/app-shell/); this page describes
// it, opens with the app's ProductHero (HERO_PAGES in utils/product.ts) and
// sends people there.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import Button from '../../components/ui/Button.astro'
import Section from '../../components/ui/Section.astro'
import { APP_URL } from '../../utils/product'

const title = 'Dice Roller App'
const description =
  'A free dice roller for your phone and desktop. Type any dice notation or tap the dice, see every step of the roll, keep your recent rolls, and install it to roll offline. No account, no ads.'
const image = 'https://randsum.dev/app/roller-phone-dark.png'

const features = [
  {
    title: 'Any dice notation',
    body: 'Type 4d6L, 1d20+5, 2d8!, 4dF or anything else in RANDSUM notation, and the roller checks it as you type.'
  },
  {
    title: 'Or just tap the dice',
    body: 'Dice keys build the roll for you: tap d20 twice for 2d20, then add a bonus, drop the lowest or explode.'
  },
  {
    title: 'Every step shown',
    body: 'See each die, what was rerolled, dropped or exploded, and how the total was reached.'
  },
  {
    title: 'Your recent rolls',
    body: 'The last rolls stay beside the roller, so you can check what you rolled or roll it again.'
  },
  {
    title: 'Rolls offline',
    body: 'Install it to your home screen and it keeps rolling at the table with no signal.'
  },
  {
    title: 'No account, no tracking',
    body: 'Nothing to sign up for. History stays on your device, and the app is free and open source.'
  }
]

const installSteps = [
  {
    platform: 'iPhone and iPad',
    steps: 'Open the app in Safari, tap Share, then Add to Home Screen.'
  },
  {
    platform: 'Android',
    steps:
      'Open the app in Chrome and tap Install app in its header, or Install app in the browser menu.'
  },
  {
    platform: 'Desktop',
    steps: 'In Chrome or Edge, click the install icon at the end of the address bar.'
  }
]

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'RANDSUM Roller',
  url: APP_URL,
  description,
  applicationCategory: 'GameApplication',
  applicationSubCategory: 'Dice roller',
  operatingSystem: 'Any (installable web app)',
  browserRequirements: 'Requires a modern browser with JavaScript',
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  screenshot: image,
  image,
  author: { '@type': 'Organization', name: 'RANDSUM', url: 'https://randsum.dev/' }
})
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    head: [
      { tag: 'meta', attrs: { property: 'og:title', content: 'RANDSUM Roller' } },
      { tag: 'meta', attrs: { property: 'og:description', content: description } },
      { tag: 'script', attrs: { type: 'application/ld+json' }, content: jsonLd }
    ]
  }}
  hasSidebar={false}
>
  <div class="app-page">
    <p class="app-moved" data-app-moved hidden>
      The Roller moved to <a href={APP_URL}>app.randsum.dev</a>. Opening it now.
    </p>

    <Section
      id="screens"
      title="Built for the table"
      lede="One screen: the roll you are building, its result step by step, and your last rolls."
    >
      <div class="screens">
        <figure>
          <img
            src="/app/roller-phone-dark.png"
            alt="The Roller on a phone in dark mode, showing a 4d6L roll and its steps"
            width="390"
            height="844"
            loading="lazy"
          >
        </figure>
        <figure>
          <img
            src="/app/roller-phone-light.png"
            alt="The Roller on a phone in light mode, with the dice keys and recent rolls"
            width="390"
            height="844"
            loading="lazy"
          >
        </figure>
      </div>
    </Section>

    <Section id="features" title="What it does">
      <ul class="features">
        {features.map(feature => (
          <li>
            <h3>{feature.title}</h3>
            <p>{feature.body}</p>
          </li>
        ))}
      </ul>
    </Section>

    <Section
      id="install"
      title="Install it"
      lede="The Roller is a web app. Install it once and it opens like any other app, offline too."
    >
      <ol class="install">
        {installSteps.map(step => (
          <li>
            <h3>{step.platform}</h3>
            <p>{step.steps}</p>
          </li>
        ))}
      </ol>
    </Section>

    <Section
      id="notation"
      title="Powered by the RANDSUM roller"
      lede="The app rolls with @randsum/roller, the same engine behind the API, the Discord bot and the plugin, so a roll means the same thing everywhere."
    >
      <div class="actions">
        <Button href="/notation/getting-started/" variant="secondary">Learn the notation</Button>
        <Button href="/roller/introduction/" variant="secondary">About the roller</Button>
      </div>
    </Section>

    <Section
      id="open"
      title="Start rolling"
      lede="Free, in your browser, at app.randsum.dev. randsum.io gets you there too."
    >
      <div class="actions">
        <Button href={APP_URL} variant="product" product="app">Open the app</Button>
      </div>
    </Section>
  </div>
</StarlightPage>

<script>
// Someone who installed the Roller back when it lived here opens this page from
// their home screen; send them on to the app instead of a product page.
if (matchMedia('(display-mode: standalone)').matches) {
  const notice = document.querySelector<HTMLElement>('[data-app-moved]')
  if (notice) notice.hidden = false
  location.replace('https://app.randsum.dev/')
}
</script>

<style>
.app-page {
  padding-bottom: 4rem;
}

.app-moved {
  padding: 0.75rem 1rem;
  border: var(--rs-border);
  border-radius: var(--rs-radius-md);
  background: var(--rs-accent-low);
}

.screens {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 1.5rem;
}

.screens figure {
  flex: 0 1 18rem;
  margin: 0;
}

.screens img {
  display: block;
  width: 100%;
  height: auto;
  border: var(--rs-border);
  border-radius: var(--rs-radius-lg);
}

.features,
.install {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  gap: 1rem;
  margin: 0;
  padding: 0;
  list-style: none;
}

.features li,
.install li {
  margin: 0;
  padding: 1.25rem;
  border: var(--rs-border);
  border-radius: var(--rs-radius-lg);
}

.features h3,
.install h3 {
  margin: 0 0 0.375rem;
  font-size: var(--rs-text-base);
  font-weight: var(--rs-weight-semibold);
  color: var(--rs-fg);
}

.features p,
.install p {
  margin: 0;
  font-size: var(--rs-text-sm);
  color: var(--rs-gray-2);
}

.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}
</style>
