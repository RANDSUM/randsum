---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import KofiButton from '../components/KofiButton.astro'
import Button from '../components/ui/Button.astro'
import Card from '../components/ui/Card.astro'
import CardGrid from '../components/ui/CardGrid.astro'
import DiscordGlyph from '../components/ui/DiscordGlyph.astro'
import Section from '../components/ui/Section.astro'
import { DISCORD_INSTALL_URL } from '../utils/product'

const games = [
  {
    command: '/fifth',
    name: 'D&D 5th Edition',
    description: 'd20 + modifier with advantage/disadvantage. Nat 20 and nat 1 highlighted.',
    color: 'var(--game-fifth)',
    href: '/games/fifth/'
  },
  {
    command: '/blades',
    name: 'Blades in the Dark',
    description: 'Action dice pool — critical, success, partial, or failure.',
    color: 'var(--game-blades)',
    href: '/games/blades/'
  },
  {
    command: '/dh',
    name: 'Daggerheart',
    description: 'Hope and fear dice with modifiers and amplification.',
    color: 'var(--game-daggerheart)',
    href: '/games/daggerheart/'
  },
  {
    command: '/fate',
    name: 'Fate Core',
    description: '4dF + skill on the Fate ladder, with shifts against opposition.',
    color: 'var(--game-fate)',
    href: '/games/fate/'
  },
  {
    command: '/pbta',
    name: 'Powered by the Apocalypse',
    description: '2d6 + stat. Miss, weak hit, or strong hit for any PbtA game.',
    color: 'var(--game-pbta)',
    href: '/games/pbta/'
  },
  {
    command: '/root',
    name: 'Root RPG',
    description: '2d6 + bonus. Strong hit, weak hit, or miss.',
    color: 'var(--game-root-rpg)',
    href: '/games/root-rpg/'
  }
]

const commands = [
  {
    name: '/roll',
    description: 'Roll any dice using full RANDSUM notation',
    example: '/roll notation:4d6L+2'
  },
  { name: '/blades', description: 'Blades in the Dark action roll', example: '/blades dice:3' },
  {
    name: '/fifth',
    description: 'D&D 5e d20 roll with advantage support',
    example: '/fifth modifier:5 rolling_with:Advantage'
  },
  {
    name: '/dh',
    description: 'Daggerheart hope and fear dice',
    example: '/dh modifier:3 rolling_with:Advantage'
  },
  {
    name: '/fate',
    description: 'Fate Core 4dF + skill against the ladder',
    example: '/fate skill:3 opposition:2'
  },
  { name: '/root', description: 'Root RPG 2d6 + modifier', example: '/root modifier:2' },
  {
    name: '/salvageunion',
    description: 'Points to the SURef bot, which handles Salvage Union',
    example: '/salvageunion'
  },
  {
    name: '/pbta',
    description: 'Powered by the Apocalypse move roll',
    example: '/pbta stat:2 forward:1'
  },
  { name: '/notation', description: 'Show dice notation reference guide', example: '/notation' },
  { name: '/help', description: 'List all available RANDSUM commands', example: '/help' }
]
---

<StarlightPage
  frontmatter={{
    title: 'RANDSUM Dice Bot',
    description:
      'Roll dice for your TTRPG sessions directly in Discord. Supports D&D 5e, Blades in the Dark, Daggerheart, Fate Core, PbtA, and Root RPG.',
    template: 'splash',
    head: [
      { tag: 'meta', attrs: { property: 'og:title', content: 'RANDSUM Dice Bot' } },
      {
        tag: 'meta',
        attrs: {
          property: 'og:description',
          content:
            'Roll dice for your TTRPG sessions directly in Discord. D&D 5e, Blades in the Dark, Daggerheart, Fate Core, PbtA, and Root RPG.'
        }
      },
      {
        tag: 'meta',
        attrs: { property: 'og:image', content: 'https://randsum.dev/discord-ss-roll-10d20.png' }
      },
      { tag: 'meta', attrs: { name: 'twitter:card', content: 'summary_large_image' } },
      {
        tag: 'meta',
        attrs: { name: 'twitter:image', content: 'https://randsum.dev/discord-ss-roll-10d20.png' }
      }
    ]
  }}
  hasSidebar={false}
>
  <div class="discord-page">
    <Section
      id="games"
      title="Supported games"
      lede="Dedicated slash commands that resolve each roll by that game's own rules."
    >
      <CardGrid>
        {games.map(game => (
          <Card href={game.href} eyebrow={game.command} title={game.name} accent={game.color}>
            {game.description}
          </Card>
        ))}
      </CardGrid>
    </Section>

    <Section
      id="commands"
      title="Commands"
      lede="Every slash command the bot registers, with an example."
    >
      <div class="commands-wrap">
        <table class="commands">
          <thead>
            <tr>
              <th scope="col">Command</th>
              <th scope="col">What it does</th>
              <th scope="col">Example</th>
            </tr>
          </thead>
          <tbody>
            {commands.map(cmd => (
              <tr>
                <td>
                  <code>{cmd.name}</code>
                </td>
                <td>{cmd.description}</td>
                <td>
                  <code>{cmd.example}</code>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>

    <Section
      id="examples"
      title="What a roll looks like"
      lede="Each reply breaks the roll down step by step, coloured by outcome."
    >
      <div class="screenshots">
        <figure>
          <img
            src="/discord-ss-roll-10d20.png"
            alt="The bot's reply to /roll 10d20, totalling 100"
            loading="lazy"
          >
          <figcaption><code>/roll notation:10d20</code></figcaption>
        </figure>
        <figure>
          <img src="/discord-ss-roll-2d12.png" alt="The bot's reply to /roll 2d12+1" loading="lazy">
          <figcaption><code>/roll notation:2d12+1</code></figcaption>
        </figure>
      </div>
    </Section>

    <Section
      id="add"
      title="Add it to your server"
      lede="One click, and nothing to configure afterwards."
    >
      <div class="add-actions">
        <Button href={DISCORD_INSTALL_URL} variant="product" product="discord">
          <DiscordGlyph />
          Add to Discord
        </Button>
        <Button href="/tools/discord-bot/" variant="secondary">Read the docs</Button>
      </div>
      <div class="support"><KofiButton /></div>
    </Section>
  </div>
</StarlightPage>

<style>
.discord-page {
  padding-bottom: 4rem;
}

.commands-wrap {
  overflow-x: auto;
  border: var(--rs-border);
  border-radius: var(--rs-radius-lg);
}

.commands {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--rs-text-sm);
}

.commands th {
  padding: 0.75rem 1rem;
  border-bottom: var(--rs-border);
  background: var(--rs-gray-7);
  font-weight: var(--rs-weight-semibold);
  text-align: left;
  color: var(--rs-gray-2);
}

.commands td {
  padding: 0.75rem 1rem;
  border-bottom: var(--rs-border);
  color: var(--rs-gray-1);
  vertical-align: top;
}

.commands tr:last-child td {
  border-bottom: none;
}

.commands code {
  font-family: var(--rs-font-mono);
  font-size: var(--rs-text-xs);
  white-space: nowrap;
  color: var(--product-discord);
}

.screenshots {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
  gap: 1.5rem;
}

.screenshots figure {
  margin: 0;
}

.screenshots img {
  display: block;
  width: 100%;
  border: var(--rs-border);
  border-radius: var(--rs-radius-lg);
}

.screenshots figcaption {
  margin-top: 0.5rem;
  font-size: var(--rs-text-sm);
  color: var(--rs-gray-3);
}

.add-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.75rem;
}

.support {
  margin-top: 2rem;
}
</style>
