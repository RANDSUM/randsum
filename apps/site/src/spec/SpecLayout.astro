---
import { Font } from 'astro:assets'
import HeroHeader from './components/HeroHeader.astro'
import VersionBanner from './components/VersionBanner.astro'
import SkipLink from './components/SkipLink.astro'
import ShareActions from './components/ShareActions.astro'
import MobileMenu from './components/MobileMenu.astro'
import KofiButton from '../components/KofiButton.astro'
import './spec.css'

interface Heading {
  depth: number
  slug: string
  text: string
}

interface Props {
  title: string
  version: string
  versions: string[]
  isLatest: boolean
  specMarkdown?: string
  headings?: Heading[]
}

const { title, version, versions, isLatest, specMarkdown = '', headings = [] } = Astro.props
const pageTitle = isLatest ? `${title}` : `${title} — ${version}`
// /spec/ and /spec/v/<latest>/ render the same version (ADR-016 keeps both,
// with no redirect), so both name the versioned URL as canonical.
const specUrl = new URL(`/spec/v/${version}/`, Astro.site).href
// Starlight's Pagefind index skips pages without data-pagefind-body. Opt in
// the canonical page only, so search lists each version once.
const isCanonical = Astro.url.pathname.replace(/\/?$/, '/') === new URL(specUrl).pathname
---

<!doctype html>
<html lang="en" data-product="spec">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={specUrl} />
    <meta
      name="description"
      content="The formal specification for RANDSUM Dice Notation — a human-readable syntax for dice rolls in tabletop RPGs. Defines modifiers, execution pipeline, conformance levels, and special dice types."
    />
    <meta property="og:title" content={pageTitle} />
    <meta
      property="og:description"
      content="The formal specification for RANDSUM Dice Notation — a human-readable syntax for dice rolls in tabletop RPGs. Defines modifiers, execution pipeline, conformance levels, and special dice types."
    />
    <meta property="og:image" content="https://randsum.dev/og-image.png" />
    <meta property="og:url" content={specUrl} />
    <meta property="og:type" content="article" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta
      name="twitter:description"
      content="The formal specification for RANDSUM Dice Notation — a human-readable syntax for dice rolls in tabletop RPGs. Defines modifiers, execution pipeline, conformance levels, and special dice types."
    />
    <meta name="twitter:image" content="https://randsum.dev/og-image.png" />
    <Font cssVariable="--font-figtree" preload />
    <Font cssVariable="--font-bricolage-grotesque" />
    <Font cssVariable="--font-jetbrains-mono" />
    <script is:inline>
      // Apply the theme before render to prevent a flash: a saved choice wins,
      // otherwise follow the OS. Same key and data-theme as Starlight's picker,
      // so one choice holds across the whole site.
      const saved = (() => {
        try {
          return localStorage.getItem('starlight-theme')
        } catch {
          return null
        }
      })()
      document.documentElement.dataset.theme =
        saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark'
    </script>
  </head>
  <body>
    <SkipLink />
    <MobileMenu
      headings={headings}
      version={version}
      isLatest={isLatest}
      specMarkdown={specMarkdown}
      specUrl={specUrl}
    />
    <HeroHeader version={version} versions={versions} isLatest={isLatest} />
    <VersionBanner isLatest={isLatest} />
    <div class="spec-layout">
      <nav class="spec-sidebar" aria-label="Spec sections">
        <slot name="sidebar">
          <p class="label" style="color: var(--text-muted);">Sidebar</p>
        </slot>
      </nav>
      <main id="main-content" class="spec-content" data-pagefind-body={isCanonical ? '' : undefined}>
        <slot name="content" />
      </main>
      <aside class="spec-aside" aria-label="In this section">
        <slot name="aside">
          <p class="label" style="color: var(--text-muted);">On this page</p>
        </slot>
      </aside>
    </div>
    {specMarkdown && <ShareActions specMarkdown={specMarkdown} specUrl={specUrl} />}
    <footer class="spec-footer">
      <KofiButton />
    </footer>
    <style>
      .spec-footer {
        display: flex;
        justify-content: center;
        padding: 2rem 1rem 3rem;
        border-top: 1px solid var(--border);
      }
    </style>
    <script>
      const toggle = document.querySelector('[data-theme-toggle]')
      if (toggle) {
        toggle.addEventListener('click', () => {
          const root = document.documentElement
          const next = root.dataset.theme === 'light' ? 'dark' : 'light'
          root.dataset.theme = next
          localStorage.setItem('starlight-theme', next)
        })
      }
    </script>
  </body>
</html>
