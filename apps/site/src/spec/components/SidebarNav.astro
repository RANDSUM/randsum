---
import { type Heading, sectionGroups, navNumber, splitSectionNumber } from '../sections'

interface Props {
  headings: Heading[]
}

const { headings } = Astro.props
const grouped = sectionGroups(headings)
const first = grouped[0]?.items[0]?.slug
---

<div class="sidebar-inner">
  <p class="sidebar-title">Contents</p>
  <nav aria-label="Spec sections">
    {grouped.map(group => (
      <div class="sidebar-group">
        <span class="sidebar-group-label">{group.label}</span>
        <ol class="sidebar-list" role="list">
          {group.items.map(heading => {
            const isFirst = heading.slug === first
            const { number, title } = splitSectionNumber(heading.text)
            return (
              <li>
                <a
                  href={`#${heading.slug}`}
                  class:list={['sidebar-link', { active: isFirst }]}
                  aria-current={isFirst ? 'true' : undefined}
                  data-sidebar-link
                >
                  {number !== undefined && <span class="secno">{navNumber(number)}</span>}
                  <span>{title.replace(' (Informative)', '')}</span>
                </a>
              </li>
            )
          })}
        </ol>
      </div>
    ))}
  </nav>
</div>

<script>
const content = document.querySelector('.spec-content-body')
const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>('[data-sidebar-link]')

if (content && sidebarLinks.length > 0) {
  const state: { slug: string | null; ticking: boolean } = { slug: null, ticking: false }

  function setActive(slug: string) {
    if (slug === state.slug) return
    state.slug = slug

    for (const link of sidebarLinks) {
      const isActive = link.getAttribute('href') === `#${slug}`
      link.classList.toggle('active', isActive)
      if (isActive) {
        link.setAttribute('aria-current', 'true')
      } else {
        link.removeAttribute('aria-current')
      }
    }

    document.dispatchEvent(new CustomEvent('section-change', { detail: { slug } }))
  }

  const h2Elements = Array.from(content.querySelectorAll<HTMLHeadingElement>('h2[id]'))

  // Use scroll listener for reliable section tracking.
  // IntersectionObserver with tight rootMargin misses sections when
  // the h2 heading scrolls past the narrow trigger zone too quickly.
  function findCurrentSection(): string | null {
    const threshold = window.innerHeight * 0.2
    const firstBelow = h2Elements.findIndex(h2 => h2.getBoundingClientRect().top > threshold)
    const passed = firstBelow === -1 ? h2Elements : h2Elements.slice(0, firstBelow)
    return passed.at(-1)?.id ?? null
  }

  function onScroll() {
    if (state.ticking) return
    state.ticking = true
    requestAnimationFrame(() => {
      const slug = findCurrentSection()
      if (slug) setActive(slug)
      state.ticking = false
    })
  }

  window.addEventListener('scroll', onScroll, { passive: true })

  // Activate the first section on page load
  const initialSlug = findCurrentSection() ?? h2Elements[0]?.id
  if (initialSlug) {
    setActive(initialSlug)
  }
}
</script>
