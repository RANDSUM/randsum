---
import { Font } from 'astro:assets'
import Default from '@astrojs/starlight/components/Head.astro'
import { productForPath } from '../utils/product'

// Starlight already writes og:title and og:description from the page's frontmatter;
// Twitter falls back to them, so only the product accent and fonts are added here.
const product = productForPath(Astro.url.pathname)
---

<Default {...Astro.props}><slot /></Default>
{product && (
  <script is:inline define:vars={{ product }}>
    document.documentElement.dataset.product = product
  </script>
)}
<link rel="icon" href="/favicon.ico" sizes="32x32">
<Font cssVariable="--font-gabarito" preload />
<Font cssVariable="--font-jetbrains-mono" />
