---
import PipMark from './PipMark.astro'
import { PRODUCT_LABELS, productForPath } from '../utils/product'
const { siteTitleHref } = Astro.locals.starlightRoute
const product = productForPath(Astro.url.pathname)
---

<a href={siteTitleHref} class="site-title-link" data-pip-roll>
  <PipMark size={30} class="site-title-mark" />
  <span class="site-title-text" translate="no">RANDSUM</span>
  {product && <span class="site-title-product">{PRODUCT_LABELS[product]}</span>}
</a>

<script>
// Hover the mark: the die tumbles through four random d6 faces (1 to 6 pips),
// holding each for DWELL ms, then lands back on R. Pips a face does not use
// shrink away at the centre.
const DWELL = 300
const ROLLS = 4
const [L, M, H] = [28, 50, 72] as const
const FACES: readonly (readonly (readonly [number, number])[])[] = [
  [[M, M]],
  [
    [L, L],
    [H, H]
  ],
  [
    [L, L],
    [M, M],
    [H, H]
  ],
  [
    [L, L],
    [H, L],
    [L, H],
    [H, H]
  ],
  [
    [L, L],
    [H, L],
    [M, M],
    [L, H],
    [H, H]
  ],
  [
    [L, L],
    [H, L],
    [L, M],
    [H, M],
    [L, H],
    [H, H]
  ]
]
const pickFaces = (): readonly number[] =>
  Array.from({ length: ROLLS }).reduce<number[]>(acc => {
    const prev = acc.at(-1)
    const pool = [0, 1, 2, 3, 4, 5].filter(f => f !== prev)
    return [...acc, pool[Math.floor(Math.random() * pool.length)] ?? 0]
  }, [])
for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-pip-roll]')) {
  const circles = [...link.querySelectorAll<SVGCircleElement>('circle')]
  const home = circles.map(
    c =>
      [c.getAttribute('cx') ?? '', c.getAttribute('cy') ?? '', c.getAttribute('r') ?? ''] as const
  )
  const busy = { now: false }
  const show = (face: number): void => {
    const cells = FACES[face] ?? []
    circles.forEach((c, i) => {
      const cell = cells[i]
      c.setAttribute('cx', String(cell?.[0] ?? M))
      c.setAttribute('cy', String(cell?.[1] ?? M))
      c.setAttribute('r', cell ? (home[i]?.[2] ?? '8') : '0')
    })
  }
  link.addEventListener('mouseenter', () => {
    if (busy.now || matchMedia('(prefers-reduced-motion: reduce)').matches) return
    busy.now = true
    pickFaces().forEach((face, step) => {
      setTimeout(() => show(face), step * DWELL)
    })
    setTimeout(() => {
      circles.forEach((c, i) => {
        const [cx, cy, r] = home[i] ?? ['', '', '']
        c.setAttribute('cx', cx)
        c.setAttribute('cy', cy)
        c.setAttribute('r', r)
      })
      busy.now = false
    }, ROLLS * DWELL)
  })
}
</script>

<style>
.site-title-link {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  min-width: 0;
  color: var(--sl-color-white);
  text-decoration: none;
}

.site-title-link :global(.site-title-mark circle) {
  transition:
    cx 0.2s cubic-bezier(0.3, 1.3, 0.5, 1),
    cy 0.2s cubic-bezier(0.3, 1.3, 0.5, 1),
    r 0.2s ease-out;
}

.site-title-text {
  font-family: var(--sl-font-heading, var(--sl-font));
  font-size: var(--sl-text-h4);
  font-weight: var(--rs-weight-heavy);
  letter-spacing: var(--rs-tracking-wordmark);
  white-space: nowrap;
}

.site-title-product {
  font-family: var(--sl-font-heading, var(--sl-font));
  font-size: var(--sl-text-h4);
  font-weight: var(--rs-weight-bold);
  letter-spacing: var(--rs-tracking-heading);
  color: var(--sl-color-accent);
  white-space: nowrap;
}

@media (prefers-reduced-motion: reduce) {
  .site-title-link :global(.site-title-mark circle) {
    transition: none;
  }
}
</style>
