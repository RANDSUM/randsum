---
// Common questions, answered on the page and marked up as FAQPage data in index.astro.
import Button from '../ui/Button.astro'
import Section from '../ui/Section.astro'
import { LANDING_FAQ } from '../../utils/faq'
---

<Section
  id="faq"
  layout="split"
  title="Questions"
  lede="What RANDSUM is, where it runs and what it costs. Anything else is in the docs."
>
  <Button slot="actions" href="/welcome/introduction/" variant="secondary" size="sm">
    Read the docs
  </Button>
  <div class="faq">
    {LANDING_FAQ.map((entry, i) => (
      <details class="faq-item" open={i === 0}>
        <summary>
          <h3>{entry.question}</h3>
        </summary>
        <p>
          {entry.answer}
          {entry.link && (
            <>
              {' '}
              <a href={entry.link.href}>{entry.link.label}</a>
            </>
          )}
        </p>
      </details>
    ))}
  </div>
</Section>

<style>
.faq {
  border-top: var(--rs-border);
}

.faq-item {
  border-bottom: var(--rs-border);
}

.faq-item summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  padding: 1.1rem 0;
  cursor: pointer;
  list-style: none;
}

.faq-item summary::-webkit-details-marker {
  display: none;
}

.faq-item summary::after {
  content: '+';
  flex: none;
  font-size: var(--rs-text-lg);
  line-height: 1;
  color: var(--rs-gray-3);
  transition: transform var(--rs-duration) var(--rs-ease);
}

.faq-item[open] summary::after {
  transform: rotate(45deg);
}

.faq-item summary:hover h3 {
  color: var(--rs-gray-1);
}

.faq-item summary:focus-visible {
  outline: none;
  box-shadow: var(--rs-focus-ring);
  border-radius: var(--rs-radius-sm);
}

.faq-item h3 {
  margin: 0;
  font-family: var(--rs-font-heading);
  font-size: var(--rs-text-md);
  font-weight: var(--rs-weight-bold);
  letter-spacing: var(--rs-tracking-tight);
  line-height: var(--rs-leading-snug);
  color: var(--rs-fg);
  transition: color var(--rs-duration) var(--rs-ease);
}

.faq-item p {
  max-width: 40rem;
  margin: 0 0 1.25rem;
  color: var(--rs-gray-2);
}

.faq-item p a {
  color: var(--rs-fg);
  text-underline-offset: 0.2em;
}

.faq-item p a:hover {
  color: var(--rs-gray-1);
}

@media (prefers-reduced-motion: reduce) {
  .faq-item summary::after {
    transition: none;
  }
}
</style>
