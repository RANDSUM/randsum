---
// The top of randsum.dev: the promise on the left, the live roller on the right,
// so the first thing a visitor can do is roll.
import { APP_URL } from '../rollers/links'
import { HeroRoller, LANDING_PRESETS } from '../rollers/HeroRoller'
import ServerRoller from '../rollers/ServerRoller.astro'
import PipMark from '../PipMark.astro'
import Button from '../ui/Button.astro'
---

<section id="_top" class="hero not-content" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="hero-kicker">
        <PipMark variant="knockout" size={18} />
        The TypeScript dice engine
      </p>
      <h1 id="hero-title" class="clickable-tagline">
        Throw Dice, <br>
        Not Exceptions.
      </h1>
      <p class="hero-subtitle">
        Parse and roll any dice notation, from <code>1d20+5</code> to exploding, rerolling,
        drop-lowest pools, and get every step back as typed data. Zero dependencies, with ready-made
        rules for D&amp;D 5e, Blades in the Dark and more.
      </p>
      <div class="hero-actions">
        <Button href="/roller/getting-started/">Get started</Button>
        <Button href="/spec/" variant="secondary">Read the spec</Button>
      </div>
      <button
        class="install-cmd"
        data-cmd="bun add @randsum/roller"
        aria-label="Copy the install command"
      >
        <code>bun add @randsum/roller</code>
        <span class="install-copy-icon" aria-hidden="true"
          ><svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg></span
        >
      </button>
    </div>
    <div class="hero-roller" role="region" aria-labelledby="hero-roller-title">
      <div class="hero-roller-top">
        <h2 id="hero-roller-title" class="hero-roller-title">
          <PipMark variant="knockout" size={20} />
          Try <code>@randsum/roller</code>
        </h2>
        <span class="hero-roller-note">Runs in your browser</span>
      </div>
      <HeroRoller client:only="react">
        <ServerRoller
          slot="fallback"
          size="compact"
          notation={LANDING_PRESETS[0]?.notation ?? '4d6L'}
          presets={LANDING_PRESETS}
          appLink={APP_URL}
        />
      </HeroRoller>
    </div>
  </div>
</section>

<script>
// The tagline's easter egg: a click fires 'die-rolled', which HeroRoller answers
// by spinning through its presets. A plain h1 and a listener, so the tagline
// needs no React island.
document.getElementById('hero-title')?.addEventListener('click', () => {
  window.dispatchEvent(new CustomEvent('die-rolled'))
})
</script>
