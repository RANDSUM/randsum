---
// The top of randsum.dev: the promise on the left, the live roller on the right,
// so the first thing a visitor can do is roll.
import { ClickableTagline, HeroRollerPlayground } from '../HeroInteractive'
import PipMark from '../PipMark.astro'
import Button from '../ui/Button.astro'

const proof = [
  { value: '0', label: 'runtime dependencies' },
  { value: '26', label: 'notation modifiers' },
  { value: '7', label: 'games, ready to roll' },
  { value: 'MIT', label: 'open source' }
] as const
---

<section class="hero not-content" aria-labelledby="hero-title">
  <div class="hero-inner">
    <div class="hero-text">
      <p class="hero-kicker">
        <PipMark variant="knockout" size={18} />
        The TypeScript dice engine
      </p>
      <ClickableTagline client:load />
      <p class="hero-subtitle">
        Parse and roll any dice notation, from <code>1d20+5</code> to exploding, rerolling,
        drop-lowest pools, and get every step back as typed data. Zero dependencies, with ready-made
        rules for D&amp;D 5e, Blades in the Dark and five more games.
      </p>
      <div class="hero-actions">
        <Button href="/roller/getting-started/">Get started</Button>
        <Button href="/spec/" variant="secondary">Read the spec</Button>
      </div>
      <button
        class="install-cmd"
        data-cmd="bun add @randsum/roller"
        aria-label="Copy the install command"
      >
        <code>bun add @randsum/roller</code>
        <span class="install-copy-icon" aria-hidden="true"
          ><svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg></span
        >
      </button>
    </div>
    <div class="hero-roller" aria-label="Live dice roller">
      <div class="hero-roller-top">
        <span>Try it: <b>@randsum/roller</b></span>
        <span>Pick a roll or type your own</span>
      </div>
      <HeroRollerPlayground client:only="react" />
    </div>
  </div>
  <dl class="hero-proof">
    {proof.map(item => (
      <div>
        <dt>{item.label}</dt>
        <dd>{item.value}</dd>
      </div>
    ))}
  </dl>
</section>
