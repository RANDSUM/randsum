---
import { HeroRollerPlayground } from '../HeroInteractive'
import Button from '../ui/Button.astro'
---

<section class="features-section">
  <div class="section-inner">
    <div class="features-playground-row">
      <div class="playground-col not-content">
        <HeroRollerPlayground client:only="react" />
      </div>
      <div class="playground-pitch">
        <h2 class="pitch-heading">Every modifier, parsed and validated.</h2>
        <p class="pitch-body">
          <code>@randsum/roller</code>
          is a zero-dependency dice engine with a complete notation spec &mdash; fully specified,
          documented, and implemented. Every common rolling pattern covered so you never have to
          invent your own.
        </p>
        <div class="pitch-actions">
          <Button href="/spec/" variant="secondary" size="sm">Read the spec</Button>
        </div>
      </div>
    </div>
  </div>
</section>
