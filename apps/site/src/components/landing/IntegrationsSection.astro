---
import { IntegrationViewer } from '../IntegrationViewer'
import Button from '../ui/Button.astro'
---

<section class="integrations-section">
  <div class="section-inner">
    <div class="integrations-row">
      <div class="integrations-viewer-col not-content">
        <IntegrationViewer client:only="react" />
      </div>
      <div class="integrations-pitch">
        <h2 class="pitch-heading">Roll wherever you play.</h2>
        <p class="pitch-body">
          In your Discord, in your AI assistant, or in your dev workspace &mdash; wherever you need
          numbers, RANDSUM is there. A Discord bot for game night, a plugin and connector so
          <a href="/tools/agents/">your AI agent</a>
          rolls real dice, a public
          <a href="/api/introduction/">HTTP API</a>, and an npm package for everything else.
        </p>
        <div class="pitch-actions">
          <Button href="/tools/discord-bot/" variant="secondary" size="sm">Discord bot</Button>
          <Button href="/tools/claude-code-plugin/" variant="secondary" size="sm"
            >Claude Code plugin</Button
          >
          <Button href="/api/introduction/" variant="secondary" size="sm">HTTP API</Button>
        </div>
      </div>
    </div>
  </div>
</section>
