---
import { gamePackages } from '../../utils/packageData'
import Button from '../ui/Button.astro'
import Card from '../ui/Card.astro'
import CardGrid from '../ui/CardGrid.astro'
import Section from '../ui/Section.astro'
---

<Section id="games" title="Ready for your table">
  <Button slot="actions" href="/games/introduction/" variant="secondary" size="sm">
    All games
  </Button>
  <CardGrid>
    {gamePackages.map(pkg => (
      <Card
        href={`/games/${pkg.id}/`}
        title={pkg.displayName}
        eyebrow={pkg.npmPackage}
        accent={`var(--game-${pkg.id})`}
      >
        {pkg.description}
      </Card>
    ))}
  </CardGrid>
</Section>
