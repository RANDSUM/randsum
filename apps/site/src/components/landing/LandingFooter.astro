---
import KofiButton from '../KofiButton.astro'
import PipMark from '../PipMark.astro'

const columns = [
  {
    title: 'Products',
    links: [
      { label: 'Roller', href: '/roller/introduction/' },
      { label: 'Games', href: '/games/introduction/' },
      { label: 'API', href: '/api/introduction/' },
      { label: 'Discord bot', href: '/discord/' },
      { label: 'Agent plugin', href: '/tools/agents/' }
    ]
  },
  {
    title: 'Learn',
    links: [
      { label: 'Introduction', href: '/welcome/introduction/' },
      { label: 'Getting started', href: '/roller/getting-started/' },
      { label: 'Dice notation', href: '/notation/randsum-dice-notation/' },
      { label: 'Notation spec', href: '/spec/' },
      { label: 'Ecosystem', href: '/welcome/ecosystem-overview/' }
    ]
  },
  {
    title: 'Community',
    links: [
      { label: 'GitHub', href: 'https://github.com/RANDSUM/randsum' },
      { label: 'npm', href: 'https://www.npmjs.com/org/randsum' },
      { label: 'Add a game', href: '/games/schema/contributing-a-game/' }
    ]
  }
] as const
---

<footer class="landing-footer not-content">
  <div class="section-inner footer-grid">
    <div class="footer-brand">
      <p class="footer-wordmark"><PipMark variant="knockout" size={22} /> RANDSUM</p>
      <p class="footer-tagline">Throw Dice, Not Exceptions. MIT licensed.</p>
      <KofiButton />
    </div>
    <nav class="footer-links" aria-label="Footer">
      {columns.map(column => (
        <div class="footer-col">
          <h2>{column.title}</h2>
          <ul>
            {column.links.map(link => (
              <li>
                {link.href.startsWith('https://') ? (
                  <a href={link.href} target="_blank" rel="noopener noreferrer">
                    {link.label}
                  </a>
                ) : (
                  <a href={link.href}>{link.label}</a>
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </nav>
  </div>
</footer>
