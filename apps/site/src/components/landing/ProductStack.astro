---
// The landing page's product family: a list of every product beside one
// section each, with the product's die, pitch, a real snippet and its link.
import { Code } from 'astro-expressive-code/components'
import PipMark from '../PipMark.astro'
import { PRODUCTS, PRODUCT_LABELS } from '../../utils/product'
---

<section class="product-stack not-content" aria-labelledby="product-stack-title">
  <h2 id="product-stack-title" class="section-heading">Everything that rolls</h2>
  <div class="stack">
    <nav class="stack-nav" aria-label="Products">
      {PRODUCTS.map(product => (
        <a href={`#product-${product.id}`} style={`--p: var(--product-${product.id}-fill)`}>
          <PipMark variant="knockout" size={18} />
          {PRODUCT_LABELS[product.id]}
        </a>
      ))}
    </nav>
    <div class="stack-body">
      {PRODUCTS.map(product => (
        <article
          id={`product-${product.id}`}
          class="stack-pane"
          style={`--p: var(--product-${product.id}-fill); --p-text: var(--product-${product.id})`}
        >
          <div class="stack-copy">
            <p class="stack-name">
              <PipMark variant="knockout" size={20} />
              {PRODUCT_LABELS[product.id]}
            </p>
            <h3>{product.tagline}</h3>
            <p class="stack-summary">{product.summary}</p>
            <a class="stack-explore" href={product.href}>
              Explore {PRODUCT_LABELS[product.id]}
            </a>
          </div>
          <div class="stack-snippet">
            <Code code={product.snippet.code} lang={product.snippet.lang} wrap />
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
.product-stack {
  max-width: 72rem;
  margin: 0 auto;
  padding: 3rem 0.5rem 1rem;
}

.stack {
  display: grid;
  grid-template-columns: 12rem 1fr;
  border: 1px solid var(--sl-color-gray-5);
  border-radius: 12px;
  background: var(--sl-color-bg);
}

.stack-nav {
  position: sticky;
  top: calc(var(--sl-nav-height, 4rem) + 1rem);
  align-self: start;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  padding: 1.25rem 1rem;
}

.stack-nav a {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.4rem 0.6rem;
  border-radius: 6px;
  color: var(--sl-color-gray-2);
  font-weight: 500;
  text-decoration: none;
}

.stack-nav a:hover {
  background: var(--sl-color-gray-6);
  color: var(--sl-color-white);
}

.stack-nav :global(.pip-mark),
.stack-name :global(.pip-mark) {
  color: var(--p);
  flex: none;
}

.stack-body {
  border-left: 1px solid var(--sl-color-gray-5);
}

.stack-pane {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
  gap: 2rem;
  align-items: center;
  padding: 2rem;
  scroll-margin-top: calc(var(--sl-nav-height, 4rem) + 1rem);
}

.stack-pane + .stack-pane {
  border-top: 1px solid var(--sl-color-gray-5);
}

.stack-name {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  margin: 0;
  color: var(--p-text);
  font-weight: 700;
}

.stack-copy h3 {
  margin: 0.5rem 0;
  font-family: var(--rs-font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  line-height: 1.2;
  color: var(--sl-color-white);
}

.stack-summary {
  margin: 0 0 1.25rem;
  color: var(--sl-color-gray-2);
}

.stack-explore {
  display: inline-flex;
  padding: 0.6rem 1.2rem;
  border-radius: 8px;
  background: var(--p);
  color: var(--rs-ink);
  font-weight: 600;
  text-decoration: none;
}

.stack-explore:hover {
  background: color-mix(in srgb, var(--p) 85%, var(--rs-ink));
}

.stack-snippet {
  min-width: 0;
}

.stack-snippet :global(.expressive-code) {
  margin: 0;
}

@media (max-width: 900px) {
  .stack {
    grid-template-columns: 1fr;
  }

  .stack-nav {
    display: none;
  }

  .stack-body {
    border-left: none;
  }

  .stack-pane {
    grid-template-columns: 1fr;
    gap: 1.25rem;
    padding: 1.5rem;
  }
}
</style>
