---
import { GameSchemaViewer } from '../GameSchemaViewer'
import Button from '../ui/Button.astro'
---

<section class="game-schema-section">
  <div class="section-inner">
    <div class="game-schema-row">
      <div class="game-schema-pitch">
        <h2 class="pitch-heading">Define the rules, get the rolls.</h2>
        <p class="pitch-body">
          Describe your game&rsquo;s mechanics in a <code>.randsum.json</code> spec and
          <code>@randsum/games</code>
          generates a bespoke, fully-typed roller for that system. Adding a new game is just writing
          a config file.
        </p>
        <div class="pitch-actions">
          <Button href="/games/introduction/" variant="secondary" size="sm">Game packages</Button>
          <Button href="/games/schema/overview/" variant="secondary" size="sm"
            >Write a game spec</Button
          >
        </div>
      </div>
      <div class="game-schema-viewer-col not-content">
        <GameSchemaViewer client:only="react" />
      </div>
    </div>
  </div>
</section>
