---
// A landing-style page section: one heading, an optional lede, then content.
// Pages stack these instead of drawing dividers between blocks.
interface Props {
  title: string
  id?: string
  lede?: string
  class?: string
}

const { title, id, lede, class: className } = Astro.props
const headingId = id ? `${id}-title` : undefined
---

<section id={id} class:list={['rs-section', 'not-content', className]} aria-labelledby={headingId}>
  <header class="rs-section-header">
    <h2 id={headingId} class="rs-section-title">{title}</h2>
    {lede && <p class="rs-section-lede">{lede}</p>}
    <slot name="actions" />
  </header>
  <slot />
</section>

<style>
.rs-section {
  max-width: 72rem;
  margin: 0 auto;
  padding: 3.5rem 0.5rem 0;
}

.rs-section-header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.5rem 1.5rem;
  margin-bottom: 1.5rem;
}

.rs-section-title {
  margin: 0;
  font-family: var(--rs-font-heading);
  font-size: var(--rs-text-xl);
  font-weight: var(--rs-weight-bold);
  letter-spacing: var(--rs-tracking-heading);
  line-height: var(--rs-leading-snug);
  color: var(--rs-fg);
}

.rs-section-lede {
  grid-row: 2;
  grid-column: 1 / -1;
  max-width: 40rem;
  margin: 0;
  font-size: var(--rs-text-md);
  color: var(--rs-gray-2);
}
</style>
