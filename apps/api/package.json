  "description": "api.randsum.dev: the RANDSUM dice and random-number HTTP API, plus the remote MCP server behind the Claude connector",
  "private": true,
  "author": {
    "name": "Alex Jarvis",
    "url": "https://github.com/alxjrvs"
  },
  "license": "MIT",
