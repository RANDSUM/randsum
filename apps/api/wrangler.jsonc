{
  // Cloudflare Worker for api.randsum.dev: the /v1 REST API and the /mcp remote
  // MCP server (the Claude connector's URL). Wrangler bundles the TypeScript
  // entry itself, so like the bot this app has no `build` script; its workspace
  // dependencies must be built first, because their exports point at dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randsum-api",
  "main": "./src/index.ts",
  // Matches the other Workers (scripts/check-workspace-scripts.ts holds them
  // equal). Raise it alongside a wrangler upgrade, not by reflex: a date newer
  // than the local workerd makes `wrangler dev` refuse to start.
  "compatibility_date": "2026-07-13",
  // Declared here, not passed as `--domains`, so a deploy cannot detach the
  // hostname that docs, skills and every configured connector call. The zone is
  // on Cloudflare, so the first deploy creates the DNS record and certificate.
  "routes": [
    {
      "pattern": "api.randsum.dev",
      "custom_domain": true
    }
  ],
  // No workers.dev or preview URLs: api.randsum.dev is the only front door.
  "workers_dev": false,
  "preview_urls": false,
  // Per-IP request ceiling across every route. Cloudflare counts per location,
  // so this is a brake on a runaway script, not an exact quota. The namespace
  // id is any integer unique within the account.
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1701",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
