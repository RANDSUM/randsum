{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/*.generated.ts",
      "!**/*.generated.js",
      "!**/*.d.ts",
      "!**/.astro",
      "!**/public",
      "!**/.ladle",
      "!**/*.tsbuildinfo",
      "!**/.bunup-dts-*",
      "!**/__tests__/fixtures",
      "!.claude/skills/workers-best-practices",
      "!.claude/skills/wrangler"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "quoteProperties": "asNeeded",
      "bracketSpacing": true,
      "bracketSameLine": false
    }
  },
  "json": { "formatter": { "enabled": true, "trailingCommas": "none" } },
  "css": { "formatter": { "enabled": true, "quoteStyle": "single" } },
  "yaml": { "formatter": { "quoteStyle": "single" } },
  "html": { "experimentalFullSupportEnabled": true, "formatter": { "enabled": true } },
  "markdown": { "formatter": { "enabled": false } },
  "assist": { "enabled": false },
  "plugins": ["./biome-plugins/no-let.grit", "./biome-plugins/no-double-assertion.grit"],
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": { "preset": "none" },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "useReadonlyClassProperties": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@randsum/*/src",
                  "@randsum/*/src/**",
                  "@randsum/*/dist",
                  "@randsum/*/dist/**"
                ],
                "message": "Import a published entry point (e.g. @randsum/roller/roll), never a package's src/ or dist/."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": "error",
        "noVar": "error",
        "noDebugger": "error",
        "noConsole": { "level": "warn", "options": { "allow": ["warn", "error"] } },
        "useIterableCallbackReturn": "off",
        "noShorthandPropertyOverrides": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    },
    { "includes": ["**/package.json"], "json": { "formatter": { "lineWidth": 120 } } },
    {
      "includes": ["packages/games/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@randsum/*/src",
                      "@randsum/*/src/**",
                      "@randsum/*/dist",
                      "@randsum/*/dist/**"
                    ],
                    "message": "Import a published entry point (e.g. @randsum/roller/roll), never a package's src/ or dist/."
                  },
                  {
                    "group": ["@randsum/games/*", "!@randsum/games/schema"],
                    "message": "Games never depend on each other: import shared code from ./lib, not another game's @randsum/games/<game> subpath."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "**/*.css",
        "**/*.astro",
        "!apps/site/src/styles/theme.css",
        "!packages/ui/src/tokens.css"
      ],
      "plugins": [
        "./biome-plugins/no-raw-color.grit",
        "./biome-plugins/no-raw-type.grit",
        "./biome-plugins/no-raw-shape.grit",
        "./biome-plugins/no-uppercase-labels.grit",
        "./biome-plugins/no-decorative-gradient.grit"
      ]
    },
    {
      "includes": [
        "packages/roller/src/notation/**/*.ts",
        "packages/roller/src/tokenize.ts",
        "src/notation/**/*.ts",
        "src/tokenize.ts"
      ],
      "plugins": ["./biome-plugins/no-tokenize-modifier-import.grit"]
    },
    {
      "includes": [
        "scripts/**/*.ts",
        "**/*.bench.ts",
        "**/__benchmarks__/**/*.ts",
        "**/build.ts",
        "**/codegen.ts"
      ],
      "linter": { "rules": { "suspicious": { "noConsole": "off" } } }
    },
    {
      "includes": ["**/__tests__/**", "**/test-utils/**", "**/*.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          "style": { "noNonNullAssertion": "off" }
        }
      }
    }
  ]
}
